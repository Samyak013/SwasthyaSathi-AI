# Environment Variables Template
# Copy this to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/swasthya-sathi
NEON_API_KEY=

# OpenAI API Configuration (Optional - features work without it)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Server Configuration
PORT=5000
NODE_ENV=development
HOST=localhost

# Session Configuration (Optional)
SESSION_SECRET=your-secret-key-here

# Gmail OTP Configuration (For Real Email OTP Delivery)
# Get App Password from: https://myaccount.google.com/apppasswords
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-app-password-here
